{
  "name": "IssieSays",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --resolve-plugins-relative-to node_modules/@react-native/eslint-config",
    "start": "react-native start",
    "test": "jest",
    "deploy:android:issiesays": "PROJECT_ROOT=$(pwd) ../issie-shared/android/deploy.sh issiesays com.IssieSays",
    "deploy:ios": "bash scripts/deploy-ios.sh",
    "deploy:ios:issiesays": "bash scripts/deploy-ios.sh",
    "e2e:build": "detox build -c ios.sim.debug",
    "e2e:test": "detox test -c ios.sim.debug",
    "e2e:android:build": "detox build -c android.emu.debug",
    "e2e:android": "detox test -c android.emu.debug",
    "e2e:android:device": "detox test -c android.att.debug",
    "postinstall": "patch-package"
  },
  "dependencies": {
